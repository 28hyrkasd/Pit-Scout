    "@tanstack/react-query": "^5.107.1",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "idb": "^8.0.4",
    "lucide-react": "^1.70.0",
    "next": "16.4.5",
    "next-themes": "^0.4.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "^7.91.0",
